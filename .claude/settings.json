{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-edit.cjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/payroll-check.cjs)",
      "Bash(node .claude/hooks/guard-edit.cjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "WebFetch(domain:www.invoicerybusiness.se)",
      "Bash(node scripts/serve.cjs:*)",
      "Bash(node scripts/render-smoke.cjs)",
      "Bash(node scripts/import-check.cjs)"
    ]
  }
}
